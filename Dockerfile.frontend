# ============================================================
# IPTV Manager - Frontend (Vue.js + Nginx)
# Multi-stage build for arm64 & amd64
# ============================================================

# Stage 1: Build (使用固定平台，静态文件平台无关)
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

# 接收目标平台参数
ARG TARGETPLATFORM
ARG BUILDPLATFORM

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm run build

# Stage 2: Serve (多平台)
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 添加 OCI 标签用于 GitHub Container Registry
LABEL org.opencontainers.image.source="https://github.com/neon9809/iptv-manager"
LABEL org.opencontainers.image.description="IPTV Manager Frontend UI"
LABEL org.opencontainers.image.title="iptv-manager-frontend"

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

